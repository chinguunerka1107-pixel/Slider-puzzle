class Environment:
    def __init__(self):
        self.agents = []
        self.room_states = {"A": "Dirty", "B": "Dirty"}
        self.agent_locations = []

    def add_agent(self, agent, location):
        # Agent, A
        # Agent, B
        self.agents.append(agent)
        self.agent_locations.append(location)

    def update(self, agent_index, action):
        location = self.agent_locations[agent_index]

        if action == "Left":
            if location == "B":
                self.agent_locations[agent_index] = "A"

        elif action == "Right":
            if location == "A":
                self.agent_locations[agent_index] = "B"

        elif action == "Suck":
            state = self.room_states[location]
            if state == "Dirty":
                self.room_states[location] = "Clean"

    def run(self):
        for iter in range(10):
            for i, agent in enumerate(self.agents):
                agent_location = self.agent_locations[i]
                room_state = self.room_states[agent_location]
                action = agent.run((agent_location, room_state))
                self.update(i, action)

    def __str__(self):
        return f"A: {self.room_states['A']} B: {self.room_states['B']}"

        

class Agent :
    def sense(self):
        return ["B", "Clean"]
    
    def do_program(self):
        [room, state] = self.percepts

        if room == "A":
            if state == "Clean":
                return "Right"
            else:
                return "Suck"
        else:
            if state == "clean":
                return "Left"
            else:
                return "Suck"
            
    def do_action(self, action):
        return action

    def run(self):
        self.percepts = self.sense()
        action = self.do_program()
        return self.do_action(action)
    
my_robot = Agent()
action = my_robot.run()
print(action)



